# Keep Unix line endings in the working copy everywhere, which the bash scripts in testing/ need.
* text=auto eol=lf

# Leave development-only files out of the archives GitHub generates, which are what Composer downloads when the
# package is installed, so installs only get src/, composer.json, the README and the licence.
/.github           export-ignore
/docs              export-ignore
/testing           export-ignore
/phpstan.neon.dist export-ignore
/.editorconfig     export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
